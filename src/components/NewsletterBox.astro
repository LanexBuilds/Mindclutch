---
// Your Buttondown username (buttondown.com/<username>). Change it if yours is different.
const BUTTONDOWN_USER = 'mindclutch';
---
<section id="newsletter" class="reveal mx-auto max-w-3xl scroll-mt-28 rounded-3xl bg-gradient-to-br from-neon-cyan/60 via-white/10 to-neon-magenta/60 p-px shadow-glow-both">
  <div class="glass rounded-[23px] bg-ink/90 px-6 py-12 text-center sm:px-12">
    <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">One mind-bending fact, in your inbox.</h2>
    <p class="mx-auto mt-3 max-w-md text-zinc-400">Short, surprising science. No spam, unsubscribe anytime.</p>
    <form
      action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`}
      method="post"
      target="popupwindow"
      onsubmit={`window.open('https://buttondown.com/${BUTTONDOWN_USER}', 'popupwindow')`}
      class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row"
    >
      <label for="bd-email" class="sr-only">Email address</label>
      <input id="bd-email" type="email" name="email" required placeholder="you@email.com"
        class="w-full rounded-full border border-white/15 bg-black/60 px-5 py-3 text-white placeholder-zinc-500 shadow-[0_0_24px_-8px_rgba(0,240,255,.6)] transition focus:border-neon-cyan focus:shadow-glow-cyan" />
      <button type="submit" class="btn-glow whitespace-nowrap rounded-full px-7 py-3 font-semibold text-black">Subscribe</button>
    </form>
  </div>
</section>
