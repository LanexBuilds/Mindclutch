---
import type { CollectionEntry } from 'astro:content';
import { url, img } from '../lib/paths';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, heroImage, category, pubDate } = post.data;
const date = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a href={url(`/post/${post.slug}/`)} class="reveal group mb-6 block break-inside-avoid rounded-2xl bg-gradient-to-br from-neon-cyan/50 via-white/10 to-neon-magenta/50 p-px hover:shadow-glow-both">
  <article class="glass overflow-hidden rounded-[15px] bg-ink/80">
    <div class="overflow-hidden">
      <img src={img(heroImage)} alt={title} loading="lazy" class="w-full object-cover transition duration-700 group-hover:scale-105" />
    </div>
    <div class="p-5">
      <span class="inline-block rounded-full border border-neon-cyan/40 bg-neon-cyan/10 px-3 py-1 text-xs font-medium text-neon-cyan shadow-glow-cyan">{category}</span>
      <h3 class="mt-3 font-display text-xl font-bold leading-snug text-white">{title}</h3>
      <p class="mt-2 text-sm text-zinc-500">{date}</p>
    </div>
  </article>
</a>
