---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterBox from '../components/NewsletterBox.astro';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 9 });
}
const { page } = Astro.props;
---
<Layout title="Mindclutch | Expand Your Mind. One Fact at a Time.">
  <section class="mx-auto max-w-5xl px-6 pb-20 pt-16 text-center">
    <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-7xl md:text-8xl">
      Expand Your Mind.<br /><span class="text-glow-gradient">One Fact at a Time.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-zinc-400">Science facts and deep dives, told fast and told well.</p>
    <a href="#newsletter" class="btn-glow mt-10 inline-block rounded-full px-10 py-4 text-lg font-semibold text-black">Subscribe</a>
  </section>

  <section id="feed" class="mx-auto max-w-6xl scroll-mt-28 px-6">
    {page.data.length === 0
      ? <p class="py-20 text-center text-zinc-500">No posts yet. Add a .md file to src/content/posts/ and it will appear here.</p>
      : <div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
          {page.data.map((post) => <PostCard post={post} />)}
        </div>}

    {(page.url.prev || page.url.next) && (
      <nav class="mt-10 flex items-center justify-between text-sm" aria-label="Pagination">
        {page.url.prev ? <a href={page.url.prev} class="glass rounded-full px-6 py-2 text-white transition hover:shadow-glow-cyan">Newer facts</a> : <span />}
        <span class="text-zinc-500">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next} class="glass rounded-full px-6 py-2 text-white transition hover:shadow-glow-magenta">Older facts</a> : <span />}
      </nav>
    )}
  </section>

  <div class="mt-28 px-6"><NewsletterBox /></div>
</Layout>
