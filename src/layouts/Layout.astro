---
import Navbar from '../components/Navbar.astro';
interface Props { title: string; description?: string; image?: string }
const { title, description = 'Science facts and deep dives. Expand your mind, one fact at a time.', image } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body class="bg-obsidian font-sans text-zinc-300 antialiased min-h-screen overflow-x-hidden">
    <div class="pointer-events-none fixed inset-0" aria-hidden="true">
      <div class="absolute -top-40 -left-32 h-[34rem] w-[34rem] rounded-full bg-neon-cyan/15 blur-[140px] animate-float"></div>
      <div class="absolute top-1/3 -right-40 h-[32rem] w-[32rem] rounded-full bg-neon-magenta/15 blur-[140px] animate-float" style="animation-delay:-4s"></div>
    </div>
    <Navbar />
    <main class="relative z-10 pt-28">
      <slot />
    </main>
    <footer class="relative z-10 mt-24 border-t border-white/10 py-10 text-center text-sm text-zinc-500">
      © {new Date().getFullYear()} Mindclutch. Facts worth keeping.
    </footer>

    <script>
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('show'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  ::selection { background: rgba(0,240,255,.35); color: #fff; }
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .8s ease, box-shadow .5s ease; }
  .reveal.show { opacity: 1; transform: none; }
  .glass { background: rgba(255,255,255,.04); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,.09); }
  .text-glow-gradient { background: linear-gradient(90deg,#00f0ff,#ff00ff,#00f0ff); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: shift 6s ease infinite; }
  .btn-glow { background: linear-gradient(90deg,#00f0ff,#ff00ff,#00f0ff); background-size: 200% 100%; transition: background-position .5s ease, box-shadow .3s ease, transform .3s ease; box-shadow: 0 0 28px -6px rgba(0,240,255,.6); }
  .btn-glow:hover { background-position: 100% 0; box-shadow: 0 0 40px -4px rgba(255,0,255,.7); transform: translateY(-1px); }
  a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid #00f0ff; outline-offset: 3px; }

  .prose-mc { font-size: 1.125rem; line-height: 1.85; color: #d4d4d8; }
  .prose-mc > * + * { margin-top: 1.4em; }
  .prose-mc h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1.9rem; font-weight: 700; color: #fff; margin-top: 2.2em; line-height: 1.2; }
  .prose-mc h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; font-weight: 700; color: #fff; margin-top: 1.8em; }
  .prose-mc strong { color: #fff; }
  .prose-mc a { color: #00f0ff; text-decoration: underline; text-underline-offset: 4px; }
  .prose-mc ul, .prose-mc ol { padding-left: 1.4em; }
  .prose-mc ul { list-style: disc; } .prose-mc ol { list-style: decimal; }
  .prose-mc img { border-radius: 1rem; }
  .prose-mc code { background: rgba(255,255,255,.08); padding: .15em .4em; border-radius: .4rem; font-size: .9em; }
  .prose-mc hr { border-color: rgba(255,255,255,.1); }
  .prose-mc blockquote { position: relative; padding: 1.2rem 1.5rem 1.2rem 1.8rem; border-radius: 0 1rem 1rem 0; background: linear-gradient(90deg, rgba(0,240,255,.08), rgba(255,0,255,.05)); font-family: 'Space Grotesk', sans-serif; font-size: 1.35rem; line-height: 1.5; color: #fff; }
  .prose-mc blockquote::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 4px; background: linear-gradient(180deg,#00f0ff,#ff00ff); box-shadow: 0 0 16px rgba(0,240,255,.6); }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    * { animation: none !important; scroll-behavior: auto !important; }
  }
</style>
